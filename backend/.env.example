# JanSakshi Backend Environment Variables
# Copy this file to .env and fill in values before running

# Server
APP_ENV=development
PORT=8000

# Authentication & Session Policy
JWT_SECRET=your_secure_random_jwt_secret_key_here
JANSAKSHI_SESSION_POLICY=standard
JANSAKSHI_DEMO_MODE=false

# Frontend origin (adjust for production)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (SQLite default for local dev, or PostgreSQL/Supabase)
DATABASE_URL=sqlite:///./jansakshi.db

# -------------------------------------------------------------
# Google Gemini Multimodal AI Configuration (Phase 4)
# -------------------------------------------------------------
# Leave empty until you obtain a Gemini API key from Google AI Studio
# Format: GEMINI_API_KEY=AIzaSy...
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_ANALYSIS_ENABLED=true
AI_CONFIDENCE_THRESHOLD=0.75

# File Upload Storage
# UPLOAD_DIR=./storage/evidence

# -------------------------------------------------------------
# Gmail AI Integration Configuration (Phase 6)
# -------------------------------------------------------------
# Official dedicated municipal complaint-receiving inbox
GMAIL_INBOX_ADDRESS=jansakshiofficial@gmail.com
# Set GMAIL_ENABLED=true once OAuth credentials or token file is added
GMAIL_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/email/oauth/callback
GMAIL_TOKEN_PATH=storage/gmail_tokens.json
GMAIL_CREDENTIALS_FILE=storage/gmail_credentials.json
GMAIL_INBOX_LABEL=INBOX
GMAIL_POLL_INTERVAL_SECONDS=60
FRONTEND_URL=http://localhost:5173
